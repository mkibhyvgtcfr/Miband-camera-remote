{
  "package": "com.miband.camremote",
  "name": "米环相机",
  "versionName": "1.0.1",
  "versionCode": 2,
  "minPlatformVersion": 1200,
  "icon": "/common/icon.png",
  "deviceTypeList": [
    "watch"
  ],
  "features": [
    {
      "name": "system.interconnect"
    },
    {
      "name": "system.router"
    },
    {
      "name": "system.vibrator"
    }
  ],
  "config": {
    "logLevel": "log",
    "designWidth": 212
  },
  "router": {
    "entry": "pages/index",
    "pages": {
      "pages/index": {
        "component": "index",
        "path": "/"
      },
      "pages/shutter": {
        "component": "shutter",
        "path": "/pages/shutter"
      },
      "pages/params": {
        "component": "params",
        "path": "/pages/params"
      }
    }
  },
  "display": {
    "backgroundColor": "#000000"
  },
  "minAPILevel": 1
}