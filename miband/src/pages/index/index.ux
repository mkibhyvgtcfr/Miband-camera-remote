  color: #9b968f;
  font-size: 14px;
}
.hero {
  width: 184px;
  height: 156px;
  margin-top: 10px;
  border-radius: 22px;
  background-color: #141210;
  border: 1px solid #2b211a;
  padding: 15px 16px;
  flex-direction: column;
}
