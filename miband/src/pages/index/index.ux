  color: #ff9a52;
  font-size: 11px;
  letter-spacing: 1px;
}
.hero-title {
  color: #f7f2ea;
  font-size: 22px;
  font-weight: bold;
  margin-top: 5px;
  width: 152px;
  height: 30px;
}
