  flex-direction: row;
  margin-top: 8px;
}
.stat {
  flex: 1;
  flex-direction: column;
}
.stat-k {
  color: #77726b;
  font-size: 11px;
}
.stat-v {
  color: #f7f2ea;
  font-size: 15px;
  font-weight: bold;
  margin-top: 1px;
}
.expo {
  width: 184px;
  height: 58px;
  margin-top: 8px;
  border-radius: 18px;
  background-color: #101112;
  flex-direction: row;
  align-items: center;
}
.expo-cell {
  flex: 1;
  height: 50px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.expo-k {
  color: #77726b;
  font-size: 11px;
}
.expo-v {
  color: #f7f2ea;
  font-size: 17px;
  font-weight: bold;
  margin-top: 1px;
}
.expo-line {
  width: 1px;
  height: 28px;
  background-color: #26282b;
}
.cta {
  width: 184px;
  height: 50px;
  margin-top: 8px;
  border-radius: 18px;
  background-color: #ff6900;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}
.cta-text {
  color: #ffffff;
  font-size: 20px;
  font-weight: bold;
}
.cta-arrow {
  color: #ffffff;
  font-size: 28px;
  margin-left: 6px;
}
.ghost {
  width: 184px;
  height: 36px;
  margin-top: 6px;
  border-radius: 15px;
  background-color: #141416;
  align-items: center;
  justify-content: center;
}
.ghost-text {
  color: #b8b2aa;
  font-size: 15px;
}
.tip {
  width: 184px;
  height: 44px;
  margin-top: 7px;
  flex-direction: row;
  align-items: center;
}
.tip-dot {
  width: 5px;
