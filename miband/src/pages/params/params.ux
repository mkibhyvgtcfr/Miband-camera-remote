  color: #8d877f;
  font-size: 15px;
}
.head {
  width: 184px;
  height: 48px;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
}
.title {
  color: #f7f2ea;
  font-size: 30px;
  font-weight: bold;
}
.sub {
  color: #77726b;
  font-size: 15px;
  width: 108px;
  text-align: right;
  margin-bottom: 4px;
}
.hint {
  width: 184px;
  height: 24px;
  color: #77726b;
  font-size: 15px;
  margin-top: 4px;
}
.row {
  width: 184px;
  height: 64px;
  margin-top: 7px;
  border-radius: 18px;
  background-color: #111213;
  border: 1px solid #23252a;
  flex-direction: row;
  align-items: center;
  padding-left: 14px;
  padding-right: 8px;
}
.row-left {
  flex: 1;
  flex-direction: column;
}
.row-k {
  color: #817c75;
  font-size: 15px;
}
.row-v {
  color: #f7f2ea;
  font-size: 26px;
  font-weight: bold;
  margin-top: 1px;
}
.step {
  width: 42px;
  height: 44px;
  border-radius: 13px;
  background-color: #1c1e21;
  align-items: center;
  justify-content: center;
}
.step-plus {
  background-color: #2a1a0d;
  margin-left: 5px;
}
.step-t {
  color: #e8e2da;
  font-size: 26px;
  font-weight: bold;
}
.status {
  width: 184px;
  height: 20px;
  color: #77726b;
  font-size: 15px;
  text-align: center;
  margin-top: 5px;
}
.spacer {
  flex: 1;
}
.tabs {
  width: 184px;
  height: 42px;
  border-radius: 16px;
  background-color: #101112;
  flex-direction: row;
  align-items: center;
  padding: 3px;
  margin-bottom: 8px;
}
.tab {
  flex: 1;
  height: 36px;
  border-radius: 13px;
  align-items: center;
  justify-content: center;
}
.tab-active {
  background-color: #2a1a0d;
}
