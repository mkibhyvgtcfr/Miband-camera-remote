}
.spacer {
  flex: 1;
}
.tabs {
  width: 184px;
  height: 42px;
  border-radius: 16px;
  background-color: #101112;
  flex-direction: row;
  align-items: center;
  padding: 3px;
  margin-bottom: 8px;
}
.tab {
  flex: 1;
  height: 36px;
