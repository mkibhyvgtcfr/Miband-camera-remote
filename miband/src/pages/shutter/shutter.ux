  color: #f7f2ea;
  font-size: 30px;
  font-weight: bold;
}
.sub {
  color: #77726b;
  font-size: 15px;
  width: 100px;
  text-align: right;
  margin-bottom: 4px;
}
.finder {
  width: 184px;
  height: 106px;
  margin-top: 8px;
  border-radius: 20px;
  background-color: #0d0e0f;
  border: 1px solid #24262a;
  padding: 11px 14px;
  flex-direction: column;
}
.finder-top {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.live {
  flex-direction: row;
  align-items: center;
}
.live-dot {
  width: 6px;
  height: 6px;
  border-radius: 3px;
  background-color: #5b5b5b;
  margin-right: 5px;
}
