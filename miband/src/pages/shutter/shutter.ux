  background-color: #ff6900;
}
.live-text {
  color: #9a948c;
  font-size: 14px;
  letter-spacing: 1px;
}
.battery {
  color: #77726b;
  font-size: 15px;
}
.expo {
  flex-direction: row;
  align-items: flex-end;
  margin-top: 8px;
}
.expo-main {
  color: #f7f2ea;
  font-size: 28px;
  font-weight: bold;
}
.expo-sub {
  color: #8d877f;
  font-size: 13px;
  margin-left: 8px;
  margin-bottom: 3px;
}
.ev {
  color: #ff8b35;
  font-size: 15px;
  margin-top: 3px;
}
.shutter-area {
  width: 184px;
  height: 152px;
  margin-top: 9px;
  align-items: center;
  justify-content: center;
}
.shutter-ring {
  width: 144px;
  height: 144px;
  border-radius: 72px;
  border: 2px solid #3a2515;
  align-items: center;
  justify-content: center;
}
.shutter {
  width: 130px;
  height: 130px;
  border-radius: 65px;
  background-color: #ff6900;
  border: 4px solid #ffb27a;
  align-items: center;
  justify-content: center;
  flex-direction: column;
}
.shutter-busy {
  background-color: #6b3b16;
  border-color: #8e5a30;
}
.shutter-text {
  color: #ffffff;
  font-size: 28px;
  font-weight: bold;
}
.shutter-sub {
  color: #ffe1cc;
