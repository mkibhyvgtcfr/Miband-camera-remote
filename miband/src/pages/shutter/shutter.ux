<template>
  <div class="page">
    <div class="top">
      <text class="brand">SHUTTER</text>
      <div class="link">
        <div class="dot {{connected ? 'dot-on' : ''}}"></div>
        <text class="link-text">{{connected ? '手机在线' : '未连接'}}</text>
      </div>
    </div>

    <div class="head">
      <text class="title">快门</text>
      <text class="sub">{{model}}</text>
    </div>

    <div class="finder">
      <div class="finder-top">
        <div class="live">
          <div class="live-dot {{cameraReady ? 'live-on' : ''}}"></div>
          <text class="live-text">{{cameraReady ? 'READY' : 'OFFLINE'}}</text>
        </div>
        <text class="battery">{{battery >= 0 ? battery + '%' : '—'}}</text>
      </div>
      <div class="expo">
        <text class="expo-main">{{shutter}}</text>
        <text class="expo-sub">{{aperture}} · {{iso}}</text>
      </div>
      <text class="ev">EV {{ev}}</text>
    </div>

    <div class="shutter-area">
      <div class="shutter-ring">
        <div class="shutter {{busy ? 'shutter-busy' : ''}}" @click="shoot">
          <text class="shutter-text">{{busy ? '处理中' : '拍摄'}}</text>
          <text class="shutter-sub">{{busy ? '请稍候' : '轻触释放'}}</text>
        </div>
      </div>
    </div>

    <div class="mini-row">
      <div class="mini" @click="focus">
        <text class="mini-text">对焦</text>
      </div>
      <div class="mini" @click="toggleRecord">
        <text class="mini-text {{recording ? 'rec-on' : ''}}">{{recording ? '停止' : '录像'}}</text>
      </div>
    </div>

    <text class="status">{{statusText}}</text>
    <div class="spacer"></div>

    <div class="tabs">
      <div class="tab" @click="goHome"><text class="tab-text">状态</text></div>
      <div class="tab tab-active"><text class="tab-text tab-text-active">快门</text></div>
      <div class="tab" @click="goParams"><text class="tab-text">参数</text></div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'

export default {
  data: {
    connected: false,
    cameraReady: false,
    model: '等待相机',
    battery: -1,
    iso: '—',
    shutter: '—',
    aperture: '—',
    ev: '—',
    busy: false,
    recording: false,
    statusText: '等待手机指令'
  },
  onInit() {
    this.scheduleBind()
  },
  onShow() {
    this.scheduleBind()
    if (this.conn) this.send({ v: 1, cmd: 'status' })
    this.startPolling()
  },
  onHide() {
    this.stopPolling()
  },
  onDestroy() {
    this.stopPolling()
  },
  scheduleBind() {
    if (this.bindScheduled) return
    this.bindScheduled = true
    const self = this
    setTimeout(function () {
      self.bindScheduled = false
      try {
        self.bindChannel()
      } catch (e) {
        self.showLinkError(e)
      }
    }, 300)
  },
  showLinkError(e) {
    this.connected = false
    this.cameraReady = false
    this.statusText = '通信接口不可用，请更新手环系统'
    console.error('bind channel failed', e)
  },
  bindChannel() {
    if (!this.interconnect) {
      try {
        this.interconnect = require('@system.interconnect')
      } catch (e) {
        this.showLinkError(e)
        return
      }
    }
    if (!this.interconnect) {
      this.showLinkError('interconnect module unavailable')
      return
    }
    if (!this.conn) this.conn = this.interconnect.instance()
    if (this.bound || !this.conn) return
    this.bound = true
    const self = this
    this.conn.onopen = function () {
      self.connected = true
      self.statusText = '手机通道在线'
      self.send({ v: 1, cmd: 'status' })
    }
    this.conn.onclose = function () {
      self.connected = false
      self.cameraReady = false
      self.statusText = '手机通道断开'
    }
    this.conn.onerror = function () {
      self.connected = false
      self.statusText = '请安装并打开手机端应用'
    }
    this.conn.onmessage = function (res) {
      self.handleMessage(res)
    }
    this.conn.getReadyState({
      success: function (res) {
        if (res.status === 1) self.connected = true
      }
    })
  },
  handleMessage(res) {
    try {
      let raw = res && res.data !== undefined ? res.data : res
      if (typeof raw === 'string') raw = JSON.parse(raw)
      if (raw && raw.data && typeof raw.data === 'string') raw = JSON.parse(raw.data)
      if (raw && raw.data && typeof raw.data === 'object') raw = raw.data
      if (!raw) return
      if (raw.type === 'ack') {
        if (!raw.ok && raw.message) this.statusText = raw.message
        return
      }
      if (raw.type !== 'state') return
      this.connected = true
      this.cameraReady = !!raw.connected
      this.model = raw.model || '等待相机'
      this.battery = typeof raw.battery === 'number' ? raw.battery : -1
      this.iso = raw.iso || '—'
      this.shutter = raw.shutter || '—'
      this.aperture = raw.aperture || '—'
      this.ev = raw.ev || '—'
      this.busy = !!raw.busy
      this.recording = !!raw.recording
      this.statusText = raw.connected ? (raw.message || '相机就绪') : '请在手机端连接相机'
      if (this.lastBusy && !this.busy) {
        this.vibrate()
        this.statusText = '拍摄完成'
      }
      this.lastBusy = this.busy
    } catch (e) {
      console.log('state parse error', e)
    }
  },
  shoot() {
    if (!this.cameraReady || this.busy) {
      this.statusText = this.cameraReady ? '相机正在处理，请稍候' : '请先在手机端连接相机'
      return
    }
    this.vibrate()
    this.statusText = '快门已发送…'
    this.send({ v: 1, cmd: 'capture' })
  },
  focus() {
    if (!this.cameraReady) {
      this.statusText = '请先在手机端连接相机'
      return
    }
    this.vibrate()
    this.statusText = '正在对焦…'
    this.send({ v: 1, cmd: 'focus' })
  },
  toggleRecord() {
    if (!this.cameraReady) {
      this.statusText = '请先在手机端连接相机'
      return
    }
    this.vibrate()
    this.send({ v: 1, cmd: 'record', value: !this.recording })
    this.statusText = this.recording ? '正在停止录像…' : '正在开始录像…'
  },
  send(payload) {
    const self = this
    if (!this.conn || typeof this.conn.send !== 'function') return
    try {
      this.conn.send({
        data: payload,
        success: function () {},
        fail: function (data, code) {
          self.connected = false
          self.statusText = '发送失败 ' + code
        }
      })
    } catch (e) {
      self.connected = false
      self.statusText = '发送异常'
      console.error('send failed', e)
    }
  },
  startPolling() {
    this.stopPolling()
    const self = this
    this.timer = setInterval(function () {
      self.send({ v: 1, cmd: 'status' })
    }, 2000)
  },
  stopPolling() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = null
    }
  },
  goHome() {
    router.replace({ uri: '/pages/index' })
  },
  goParams() {
    router.replace({ uri: '/pages/params' })
  },
  vibrate() {
    try {
      if (!this.vibrator) this.vibrator = require('@system.vibrator')
      this.vibrator.vibrate({ mode: 'short' })
    } catch (e) {}
  }
}
</script>

<style>
.page {
  width: 212px;
  height: 520px;
  background-color: #000000;
  flex-direction: column;
  align-items: center;
}
.top {
  width: 184px;
  height: 30px;
  margin-top: 28px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
